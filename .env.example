# ===================
#  REQUIRED
# ===================

GOOGLE_MAPS_API_KEY=your_google_maps_api_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
TRIP_MONGODB_USER=your_trip_db_user
TRIP_MONGODB_PASSWORD=your_trip_db_password
TRIP_MONGODB_HOST=localhost
TRIP_MONGODB_PORT=27017

# ===================
#  OPTIONAL
# ===================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=*

JWT_SECRET=supersecret
JWT_EXPIRES_IN=2592000

VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_USERNAME=
VALKEY_PASSWORD=
VALKEY_TLS=false

QUEUE_REDIS_HOST=
QUEUE_REDIS_PORT=
QUEUE_REDIS_USERNAME=
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_DB=1
QUEUE_REDIS_TLS=false

USERS_SERVICE_URL=http://localhost:3001
USERS_SERVICE_TIMEOUT=30000
USERS_SERVICE_RETRY_COUNT=3
USERS_SERVICE_RETRY_DELAY=1000

AUTH_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_TIMEOUT=5000
AUTH_SERVICE_RETRY_COUNT=3
AUTH_SERVICE_RETRY_DELAY=1000

DEFAULT_RETRY_COUNT=3
DEFAULT_RETRY_DELAY=1000

REDIS_DRIVER_LOCATION_EXPIRY=900
REDIS_ACTIVE_DRIVER_EXPIRY=1800
REDIS_ACTIVE_CUSTOMER_EXPIRY=1800

QUEUE_REMOVE_ON_COMPLETE=100
QUEUE_REMOVE_ON_FAIL=50
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=2000

TRIP_MONGODB_DATABASE=admin
# Full URI overrides host/port/user/password above (e.g. mongodb://dev-user:dev-password@localhost:27017/1driver?authSource=admin)
TRIP_MONGODB_URI=
TRIP_COST_PER_MINUTE=1
DRIVER_EARNINGS_PER_MINUTE=0.5
TRIP_DRIVER_RESPONSE_TIMEOUT=120
TRIP_TIMEOUT_CHECK_INTERVAL=30

LOG_LEVEL=debug
LOGGING_FILE_ENABLED=true
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_ERROR_MAX_FILES=30d

SENTRY_DSN=
SENTRY_RELEASE=1.0.0
SENTRY_SERVER_NAME=
SENTRY_SERVICE=1driver-main-api
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

SPACES_REGION=
SPACES_ENDPOINT=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_BUCKET_NAME=
SPACES_CDN_ENDPOINT=

SMS_API_KEY=
SMS_CLIENT_ID=
SMS_BASE_URL=https://user.digitizebirdsms.com/api/v2
SMS_OTP_EXPIRY_MINUTES=2
SMS_SENDER_ID=DRIVER

EXPO_ACCESS_TOKEN=

MOBILE_BUILD_VERSION=1.0.0
MOBILE_OTP_EXPIRY_MINUTES=2
MOBILE_TRIP_CANCELLABLE_TIME_MINUTES=5
MOBILE_CONFIG_CACHE_TTL_SECONDS=3600

DRIVER_LATEST_VERSION=1.0.0
CUSTOMER_LATEST_VERSION=1.0.0
